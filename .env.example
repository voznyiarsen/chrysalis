PUPA_HOST=localhost
PUPA_PORT=25565
PUPA_NAME=Pupa
PUPA_VERSION=1.12.2
DEBUG_COMMANDS=0

# E2E Test Server Configuration
E2E_HOST=pi.hole
E2E_PORT=25565
E2E_USERNAME=TestBot
E2E_VERSION=1.12.2
E2E_TIMEOUT=30
# Unique per concurrent `npm run test:e2e` session (auto-generated if unset).
# Usernames become inv|jmp|prl|pvp_<suffix> (16-char limit).
E2E_SUFFIX=
# E2E bots need operator status for /give, /tp, /gamemode, /effect, /summon.
# Grant via server console, e.g.: /op inv_mysuffix
# (RCON is not used by the bot or tests.)