PUPA_HOST=localhost
PUPA_PORT=25565
PUPA_NAME=Pupa
PUPA_VERSION=1.12.2

# E2E Test Server Configuration
E2E_HOST=pi.hole
E2E_PORT=25565
E2E_USERNAME=TestBot
E2E_VERSION=1.12.2
E2E_TIMEOUT=30
# Unique per concurrent `npm run test:e2e` session (auto-generated if unset).
# Usernames become inv|jmp|prl|pvp_<suffix> (16-char limit).
E2E_SUFFIX=
# E2E bots need operator status for /give, /tp, /gamemode, /effect, /summon.
# Preferred: `npm run e2e:op` (uses RCON when RCON_PASS is set, else relays
# through the Pupa bot). Fallback: /op <username> on the server console.
# Suites that need hostiles/food-drain set `/difficulty normal` in beforeAll
# and restore peaceful in afterAll (see tests/e2e/setup.ts ensureHostiles).

# RCON (optional, used by `npm run e2e:op` for durable OP grants).
# NEVER commit a real password — pass it via environment only.
RCON_HOST=nibble.internal
RCON_PORT=25575
RCON_PASS=